 "blocks": [
  {
   "id": "kinoshita-toshiharu-933545-0001",
   "pid": "933545",
   "pages": [
    8
   ],
   "no": null,
   "maki": "みちのくにて",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "みちのくの一の關より四里入りし畷に日暮れ螢火をみる賊住みし窟に近きみちのくの水田の畔に燃ゆるほたる火みちのくの石原道に日は暮れて搖るる俥に螢とびくる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0002",
   "pid": "933545",
   "pages": [
    9
   ],
   "no": null,
   "maki": "みちのくにて",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "たそがれのあかるさも消え肌さむみ心つつしみ俥にゆらる長雨がやみてみたればしみじみと秋はわれらに交りゐたり今われは何よりもこの山上の楓の肌にしたしめるなり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0003",
   "pid": "933545",
   "pages": [
    10
   ],
   "no": null,
   "maki": "みちのくにて",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "山深み草木しげる草木がわれにせまり來われにせまり來障子あくる音かろらかにすみたれば椽の日ざしに心よるかもこまやかに夕べの冷えが身にそひて初秋の山にさしぐみにけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0004",
   "pid": "933545",
   "pages": [
    11
   ],
   "no": null,
   "maki": "みちのくにて",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "夜がくれば「御晚になりした」と云ふ挨拶をとりかはしつつ灯をともすなり山里のかたまりあへる四五軒が道さしはさみ夜の灯ともせりなじみつる温泉の村をすてまた知らぬ山めぐる里の夕ぐれに入る",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0005",
   "pid": "933545",
   "pages": [
    12
   ],
   "no": null,
   "maki": "みちのくにて",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "東京を遠く南に感じつゝ白石町をとぼとぼあるく",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0006",
   "pid": "933545",
   "pages": [
    13
   ],
   "no": null,
   "maki": "濁り川",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "濁り川",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0007",
   "pid": "933545",
   "pages": [
    14
   ],
   "no": null,
   "maki": "濁り川",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "○桐の花雨ふる中を遠く來し常陸の國の停車塲に咲くあづまぢのみちのはてなる祝町のくるわを雨にぬれてゆきすぐ板の間のくらきに畫の遊女ゐしを見つゝ我が身は行きすぎしなり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0008",
   "pid": "933545",
   "pages": [
    15
   ],
   "no": null,
   "maki": "濁り川",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "雨後の畫を水戸市に入ればひた〳〵と水にごりみてる路傍の小川樟にほす子供の着物うつりたる雨後の塲末のうす濁り川公園の梅林の青葉がくれの青き實のその畫われにしたしみしなり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0009",
   "pid": "933545",
   "pages": [
    16
   ],
   "no": null,
   "maki": "濁り川",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "いましがた我が身のありし丘をよそに汽車は汽車とて走せすぎにけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0010",
   "pid": "933545",
   "pages": [
    18
   ],
   "no": null,
   "maki": "畫間",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "牡丹園のすだれをもれて一ところ入日があたり牡丹默せりわが瞳華美にびゝしくとらへつゝおし默りゐる胴慾な牡丹本所錦糸堀のたまり水に日暮れ闇はひ風のさむしも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0011",
   "pid": "933545",
   "pages": [
    19
   ],
   "no": null,
   "maki": "畫間",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "黑い工塲とたまり水の間にたそがれの白き道あり人力走りすゝむ生きものゝ身うちの力そゝのかし青葉の五月の太陽が照る甲羅虫草の葉ずゑにつるみたり野原の露は畫ぬるみつゝ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0012",
   "pid": "933545",
   "pages": [
    20
   ],
   "no": null,
   "maki": "畫間",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "核かづき黑土いづるこの芽生へまことにこれは力持てるよ綠葉の陰に嬰兒の足の指ならべみ山すゞ蘭花もちにけりほの〳〵とわがこゝろねのかなしみに咲きつづきたる白き野いばら",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0013",
   "pid": "933545",
   "pages": [
    21
   ],
   "no": null,
   "maki": "畫間",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "夕がたの雨あたゝかく野いばらにぬれそゝぐなりなつかしいかも目の前の日なたの地に來て砂あびる思へば雀も可愛き小鳥汽車道の赤土土手の白き花夏が身近にまたよりて來ぬ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0014",
   "pid": "933545",
   "pages": [
    22
   ],
   "no": null,
   "maki": "畫間",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "窓ぎはのとある工女の二の腕の今日も今日とてふとれるすべなさはづみある處女の肌のはねかへす物なくいたみ汗もつ畫間をんなの春の肌身の汗ばみをむし暑くつゝむ着物のおもみ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0015",
   "pid": "933545",
   "pages": [
    23
   ],
   "no": null,
   "maki": "畫間",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "淫れ女が着もののしんなり湯上りのからだにつくる畫のこゝろね見らるゝをひたひに感じうつむけるおぼこむすめのをんならしさよいちらしさ忘れもかねつ泣き居たる浴衣の胸の乳のふくらみ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0016",
   "pid": "933545",
   "pages": [
    25
   ],
   "no": null,
   "maki": "肌身",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "西洋の繪紙にて幼馴染みなる空いろばなのみちばたに咲く太陽はあたゝかにあたゝかに母らしき愛を送れり空色の花に我が顏を雨後の地面に近づけてほしいまゝにはこべを愛す",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0017",
   "pid": "933545",
   "pages": [
    26
   ],
   "no": null,
   "maki": "肌身",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "子供の頃皿に黃を溶き藍をまぜしかのみどり色にもゆる芽のあり年上の女の愛に身をつゝみあまゆるおもひ春の夜に觸る春の夜のあまきうるほひこそばゆく指尖に來てくちづけをする",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0018",
   "pid": "933545",
   "pages": [
    27
   ],
   "no": null,
   "maki": "肌身",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "この君のふところぬくきにほひよりわれつゝむらむこの母らしさは足ひろげ男ををどる彼の女こそこよひのむねをいたがゆくすれ山王の櫻しらみて夕ぐれのものはかなさに我が身のひたる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0019",
   "pid": "933545",
   "pages": [
    28
   ],
   "no": null,
   "maki": "肌身",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "茶屋女身をすてばちのあゆみぶりさくらしらみてひゆる夕方赤坂の茶屋に三味なり灯がともり山王の櫻はつめたくしらみぬ人歸りさくらしらみてくるゝなりわが身ひとつはいかにすべけむ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0020",
   "pid": "933545",
   "pages": [
    29
   ],
   "no": null,
   "maki": "肌身",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "芽ぐむ木にめぐられて立つ木は何も云はねど何か何かそゝらる高き木の新芽見あぐるわが肌の汗ばみいとし夏の秋波我が顏に青き光を受けながら藪かげ草の肌身をのぞく",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0021",
   "pid": "933545",
   "pages": [
    30
   ],
   "no": null,
   "maki": "肌身",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "足袋ぬげば春の皮膚と我が素足もつれあふこそわりなかりけれつゝましく君は小さき手をあらふ好きなその手がおとなしく濡る食卓の牡丹の花に見入りつゝ四月二十日の畫とあひみる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0022",
   "pid": "933545",
   "pages": [
    31
   ],
   "no": null,
   "maki": "肌身",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "そゞろなる浮氣娘の襟あしの生へぎはにくむ、食卓の藤思ひつめわがかなしみのほそるなり新芽に露のひゆる夕方",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0023",
   "pid": "933545",
   "pages": [
    32
   ],
   "no": null,
   "maki": "旅の雪",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "旅の雪",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0024",
   "pid": "933545",
   "pages": [
    33
   ],
   "no": null,
   "maki": "旅の雪",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "旅に來てはじめての夜のさびしきに明くれば降れる山里の雪朝の雪谷間の石につもれるを温泉のガラス戸によりそひて見る納屋の屋根の畫の雪どけ四十雀いくつも前の木の枝になく",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0025",
   "pid": "933545",
   "pages": [
    34
   ],
   "no": null,
   "maki": "旅の雪",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "向ふ岸の崖の日なたの南天の赤き實よ實よさなむづかりそ殘る雪青白みつゝ浮べるを日くれわびしくうちまもるかな磯町の床屋によりて髭剃れば鏡にうつり霰ふるなり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0026",
   "pid": "933545",
   "pages": [
    35
   ],
   "no": null,
   "maki": "旅の雪",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "去りがてに蜜柑畑をさまよひぬひくゝしげれる綠したしみ俥走り黃色の蜜柑後になり温泉の町さかる胸つぼらしさ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0027",
   "pid": "933545",
   "pages": [
    36
   ],
   "no": null,
   "maki": "糸くづ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "糸くづ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0028",
   "pid": "933545",
   "pages": [
    37
   ],
   "no": null,
   "maki": "糸くづ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "やゝ疲れ膝くづしつゝ窓による顏の上氣のにくき女よのぼせたる頰の紅のにくゝして君に奪らろゝ我が心かな腕にからむ紅き縮緬つめたさと重さおもへば君のいとしや",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0029",
   "pid": "933545",
   "pages": [
    38
   ],
   "no": null,
   "maki": "糸くづ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "心行きて指尖となりなでゝゐる女のまろくしろきたゝむき工女たち工塲の前の空地にて日の目をみつゝ遊ぶあはれさブリッヂの赤き絲くづ人ふみてなほのこりゐる赤き絲くづ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0030",
   "pid": "933545",
   "pages": [
    39
   ],
   "no": null,
   "maki": "糸くづ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "村だけの心をつくし祭禮する人たちの上に秋空くもるうき〳〵と屋臺の上に神樂せし人等いちらし雨降りいでぬさゝやかなる八兵衛稻荷の祭禮の二日目の今日も雨が降るなり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0031",
   "pid": "933545",
   "pages": [
    40
   ],
   "no": null,
   "maki": "糸くづ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "菊の中のうす黃の菊と咲き出づるこの草の上もよそにはおもはず普請塲に材木を置く遠ひゞき病みて臥す日は悲しかりけり庭見れば土にしみ入りしみ入りて冷え〳〵雨の降り出でしかな",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0032",
   "pid": "933545",
   "pages": [
    41
   ],
   "no": null,
   "maki": "糸くづ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "雨雲のひまより夕陽うすくさし今日も暮れ行く臥しつゝ居れば黑き虻白き八つ手の花に居て何かなせるを臥しつゝ見やる遲くつきし湯元の宿のくらき灯にわれ等の食べし黑き羊羹（日光の旅を憶ふ四首）",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0033",
   "pid": "933545",
   "pages": [
    42
   ],
   "no": null,
   "maki": "糸くづ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "くらき灯にわれ等居群れて冷えし手を火鉢によせし湯元の宿屋やゝ胸の惡き氣もちに仰向きし湖上の舟も今はなつかし馬返し蔦屋の椽に暮れてよりやすみし時のひもじき氣持",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0034",
   "pid": "933545",
   "pages": [
    43
   ],
   "no": null,
   "maki": "糸くづ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "敷き居たる野邊の草寢て起きもあへぬそのすなほさもみすてかねつゝ野は夕日百姓たちは黑土に鍬を打ち入れ打ち入れやまず黑土をほればひそめる百合の根に冬の日ざしのまつはりに來る",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0035",
   "pid": "933545",
   "pages": [
    45
   ],
   "no": null,
   "maki": "粉雪",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "明治屋のクリスマス飾り灯ともりてきらびやかなり粉雪降り出づきげんよくあびそてゐしが女の子たふれころびぬかたき大地に冬の日は壁と地面の直角に來りたまれりそれがよろしき",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0036",
   "pid": "933545",
   "pages": [
    46
   ],
   "no": null,
   "maki": "粉雪",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "學校に初めてわれの入りし時廊下にかなしく自家をおもひき門口にお鶴人形は膝なでゝめぐみもふかき…………とうたひ居しかな大わた小わた日の暮れ方のうら寒み綿着て飛ぶか悲しい虫よ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0037",
   "pid": "933545",
   "pages": [
    47
   ],
   "no": null,
   "maki": "粉雪",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "夕月にみんなの影のうつり居る地をなつかしみ踏み〳〵遊ぶ遲くなれば月きら〳〵とやさしさのなきも悲しく自家に歸りき眼さむれば隣の室のはなし聲そはわが上にかかはるらしも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0038",
   "pid": "933545",
   "pages": [
    48
   ],
   "no": null,
   "maki": "粉雪",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "目に白く雪の見えつゝ冬くればいよゝしたしき軒ちかき山",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0039",
   "pid": "933545",
   "pages": [
    49
   ],
   "no": null,
   "maki": "落葉樹",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "落葉樹",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0040",
   "pid": "933545",
   "pages": [
    50
   ],
   "no": null,
   "maki": "落葉樹",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "蕎麥の花しら〴〵咲けり山裾の朝日のさゝぬ斜面の畑に埼玉のとある小村の停車塲の柵のダリヤに秋の陽あつし日光にちかき停車塲杉の木の暗きが前にコスモス光る",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0041",
   "pid": "933545",
   "pages": [
    51
   ],
   "no": null,
   "maki": "落葉樹",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "文挾の停車塲の前に一本のあかるき黃色の秋の木立てり霧の粉空氣にまじる林間をつめたき手していそぐ旅人うち向ふ山の傾斜のしみ〴〵と目にしみ入りてかなしき夕べ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0042",
   "pid": "933545",
   "pages": [
    52
   ],
   "no": null,
   "maki": "落葉樹",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "黑き山へ夜の湖水こえ灯の色の月落ち行けり心をのゝく隣室のサノサ節いとものかなし湖水の岸の朝の旅籠屋落葉樹葉落つる前の黃色なる森のあかるみわれらよこぎる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0043",
   "pid": "933545",
   "pages": [
    53
   ],
   "no": null,
   "maki": "落葉樹",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "枝はなれ枯葉たゞよひ木のもとの大地につきぬなつかしいかな姉たちの乘り來し俥この宿の帳塲の前に並べるさびしさ湖じりの山あか〳〵と入日する湖水をわたる舟の旅びと",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0044",
   "pid": "933545",
   "pages": [
    54
   ],
   "no": null,
   "maki": "落葉樹",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "子供泣く暮るゝ湖水を渡り行く舟なる乳母のふところに居て男體の山のくづれのあらはなる土に夕日のさせるあはれさ男體のうへの靑空しろき雲山の秋の日おだやかに暮る",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0045",
   "pid": "933545",
   "pages": [
    55
   ],
   "no": null,
   "maki": "落葉樹",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "舟上る湖水の岸のいさゝかの畑の野菜をなつかしむかな瞳吸ふ青き野菜に目をまかせ夕べつめたき湖ぎはに立つ白樺のしろき木の肌森を行く夜の旅人のまみにつれなし",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0046",
   "pid": "933545",
   "pages": [
    56
   ],
   "no": null,
   "maki": "落葉樹",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "月になる夜の山路のつめきに姉の聲などしたしみてきく夜道行くわれ等の後について來る子供なつかし何處に行くやちやうちんに昔噺の情調をなつかしみつゝ夜の旅をする",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0047",
   "pid": "933545",
   "pages": [
    57
   ],
   "no": null,
   "maki": "落葉樹",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "森の家灯をなつかしみ立ちよれば親子集ひて火をぞ焚きける夜道するわれ等いとしも樅の木の深林を出で湖添ひを行く山上の溫泉の湧く村の十月の夜の灯にせまる寒き山の氣",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0048",
   "pid": "933545",
   "pages": [
    58
   ],
   "no": null,
   "maki": "落葉樹",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "山の温泉の古旅籠屋の障子のみしろく目に入る朝のさみしさ旅籠出でゝ山にむかへば冬の息山にかゝれり旅ごゝろ泣く山の木々沼尻の木々も冬らしくくもれる空の底に並み立つ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0049",
   "pid": "933545",
   "pages": [
    59
   ],
   "no": null,
   "maki": "落葉樹",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "山の木々黑き黃色きかさなりてわれ一人を見下すさびしさ山したひ山に來ぬればふと切に淺草などのしたはしきかな榧に似しむくつけき木がしほらしき赤き實つけて秋の日に立つ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0050",
   "pid": "933545",
   "pages": [
    60
   ],
   "no": null,
   "maki": "落葉樹",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "熊笹のうす黃が纏ふ山の上の濃き藍色の空のするどさ空の藍山の黃色のくつきりとかたみにせめぎ秋晴に立つ山火事に燒けたる木立白光る山のうへなるはつ冬の空",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0051",
   "pid": "933545",
   "pages": [
    61
   ],
   "no": null,
   "maki": "落葉樹",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "白樺の白き木肌に手をふれて眼を見ひらきぬ秋風をきく落葉ふむ足をとどめてたゝずめば沈默ひろがるまた歩み行く旅人の行く道さきにさゝやきてかなしみをよぶ落葉樹かな",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0052",
   "pid": "933545",
   "pages": [
    62
   ],
   "no": null,
   "maki": "落葉樹",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "葉も花もすがれ果てたる秋草のなほ立てるあり山の道ばたしばらくは瀧に心を吸はれつゝ秋の日なたにわれ等たゝずむうつくしきひだをつくりて流れ行きながれ行く水に愛をおぼゆる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0053",
   "pid": "933545",
   "pages": [
    63
   ],
   "no": null,
   "maki": "落葉樹",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "石楠木が蕾の用意早なりて山ふところの日だまりに立つ落葉松の山をくだりて水ひかる高原に出づやや頭痛する砂みちに空氣草履の內輪なる足跡のこるなつかしさかな",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0054",
   "pid": "933545",
   "pages": [
    64
   ],
   "no": null,
   "maki": "落葉樹",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "パラソルに秋の日光る眼の痛さやゝ疲れつゝ高原を行く大いなる斜面に秋の日を受けて男體山の夕ぐれに立つ男體の樅に紅葉に午後の日の弱まりて行く暮のしづけさ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0055",
   "pid": "933545",
   "pages": [
    65
   ],
   "no": null,
   "maki": "落葉樹",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "日光の宿のおばしま軒ちかく山高まれるなつかしさかな日光を二時間の後われ等去るおもひさびしみ御靈廟を出づ鹿沼にて姉にわかれし汽車の中のそゞろにさびし野の靄を見る",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0056",
   "pid": "933545",
   "pages": [
    66
   ],
   "no": null,
   "maki": "落葉樹",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "日光は次第に遠み過ぎ去れる旅のかなしさ野ずゑ汽車行く野原ややなぞへになれり夕月の光たまるを汽車より見やる寒き夜にかたまりあひて急ぎたる戰塲が原の思ひ出かなし",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0057",
   "pid": "933545",
   "pages": [
    67
   ],
   "no": null,
   "maki": "落葉樹",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "埼玉の小停車塲に汽車とまる橙いろのまばらなる灯よ東京に近づく汽車に日は暮れて埼玉あたり野の灯さびしも（大正元年十月）",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0058",
   "pid": "933545",
   "pages": [
    68
   ],
   "no": null,
   "maki": "地面",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "地面",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0059",
   "pid": "933545",
   "pages": [
    69
   ],
   "no": null,
   "maki": "地面",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "天氣よき日曜の朝の勸工塲日陰つめたく秋を感ずるネルに着る袷羽織の甲斐絹裏つめたき光澤のさびし雨の日わが心森の綠に浸りつゝその言ふことに醉へるさみしさ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0060",
   "pid": "933545",
   "pages": [
    70
   ],
   "no": null,
   "maki": "地面",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "橋の影うつれる河の洲に咲ける芹の小花の白のかなしさ水の音に心撫でられおとなしくあまやかさるゝ流のほとり遠く行く夜汽車の窓の暗き灯のいくつも過ぎぬ踏切に立つ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0061",
   "pid": "933545",
   "pages": [
    71
   ],
   "no": null,
   "maki": "地面",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "何處にか子供の遊ぶ聲きこえ樹陰の闇の身じろぎもせぬ膝折りて濕りを持てる土の香をかげば子供の遊びなつかしをんなの子かごめ〳〵を聲々に唄ふはかなし町の夕闇",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0062",
   "pid": "933545",
   "pages": [
    72
   ],
   "no": null,
   "maki": "地面",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "少年の記憶かなしも遊びすぎて闇のせまりしぬりごめのかげ汽笛吹き羅苧屋の車街とほる晝のこころのなごむ土曜日四十雀頰のおしろいのきはやかに時たま來り庭に遊べる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0063",
   "pid": "933545",
   "pages": [
    73
   ],
   "no": null,
   "maki": "地面",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "女の子頰ずりしたし鷄頭の毛糸の手鞠咲き出でにけり鷄頭の黃いろと赤のびらうどの玉のかはゆき秋の太陽羽織着る君が素足の冷たさのかはゆさいたみ胸にまつはる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0064",
   "pid": "933545",
   "pages": [
    74
   ],
   "no": null,
   "maki": "地面",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "そらしたるまなざし追へば追はれつつしばたたき居るまみのうるほひ今しかた茶の間の時計十うちぬ厨にあまねき秋の光線ダリヤ咲くさけばさきたるさみしさに花の瞳の淚ぐみたる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0065",
   "pid": "933545",
   "pages": [
    75
   ],
   "no": null,
   "maki": "地面",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "疲れたる光の中にコスモスのあらはに咲ける午後頭痛するコスモスの花群がりてはつきりと光をはぢくつめたき日ぐれ靑き靄灯ともし頃の冷え〳〵とすこやかなる身の食慾そゝる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0066",
   "pid": "933545",
   "pages": [
    76
   ],
   "no": null,
   "maki": "地面",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "菊切れば葉裏にひそむ虫のありうごきもやらぬこの哀れさよ森の鳥わがかなしみに針さして鳴く聲いたし山をあゆめば",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0067",
   "pid": "933545",
   "pages": [
    77
   ],
   "no": null,
   "maki": "利公の爲めに",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "利公の爲めに",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0068",
   "pid": "933545",
   "pages": [
    78
   ],
   "no": null,
   "maki": "利公の爲めに",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "あすなろの高き梢を風わたるわれは淚の目をしばたゝく愛らしき眼を見はりつゝ息づける苦しき樣を見るに堪へかぬ人皆に見捨てられたる床の上にわがをさな兒が眼をひらきゐる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0069",
   "pid": "933545",
   "pages": [
    79
   ],
   "no": null,
   "maki": "利公の爲めに",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "人目なき處に妻とかくれつゝ泣きくづれなばやすからましを夏の中にひそめる秋を感じつゝ淚ぞいづる子の死にし後程もなく秋くることのわびしさと面やつれせし妻しのび泣く",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0070",
   "pid": "933545",
   "pages": [
    80
   ],
   "no": null,
   "maki": "利公の爲めに",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "子を失ふ親の悲みそは遠きことゝ思ひしを今日われに來し待ち居たる九月の末は未だ來ず早くわが子は死にて世になし脇差のすこしぬきたる刄の上に蓮華ぞうつる凶事ありし室",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0071",
   "pid": "933545",
   "pages": [
    81
   ],
   "no": null,
   "maki": "利公の爲めに",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "おとなしき死顏を見れば可愛さに口きかずとも傍に置きたや顏のうぶ毛腕のうぶ毛の可愛さよいく日の後も眼に殘るべくやはらかくをさなきものゝおごそかに眼つぶりて我より遠し",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0072",
   "pid": "933545",
   "pages": [
    82
   ],
   "no": null,
   "maki": "利公の爲めに",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "うけ口のくちびるの色變れるに水をそゝぎて見つめ見つむる汝が母は看護もせずに別れたり母も子供もかなしかるらむ人々を力なき目に見まはせし汝がいぢらしさ忘れかねつも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0073",
   "pid": "933545",
   "pages": [
    83
   ],
   "no": null,
   "maki": "利公の爲めに",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "汽車の笛遠くひゞきて夜はふけぬ我が子の傍に通夜して居ればいとし子のつめたきからだ抱きあげ棺にうつすと頰ずりをする友禪のをんなのごとき小袖着て嬰兒は瓶の底にしづみぬ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0074",
   "pid": "933545",
   "pages": [
    84
   ],
   "no": null,
   "maki": "利公の爲めに",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "父母の涙ぬぐひしハンケチを顏にあてやり棺にをさむ小さなる笠よ草履よはた杖よ汝が旅姿ゑがくにたへず人形を相手となしてな泣きそ雨そぼふりて寂しき夜も",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0075",
   "pid": "933545",
   "pages": [
    85
   ],
   "no": null,
   "maki": "利公の爲めに",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "安らかにあれかし今はわが力及ばねばたゞそれのみをこそ木の繁る上野の奧の土しめる谷中の墓地にわが子葬る墓地の杉蟬はなけどもいとし子は姿も見えず土に入りつゝ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0076",
   "pid": "933545",
   "pages": [
    86
   ],
   "no": null,
   "maki": "利公の爲めに",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "寺の門敷石の上にさくら木の黃なる葉散れり晩夏の日照子の生れ子の死に行きし夏すぎて世は秋となり物の音すむ遠方に鍛冶屋かねうつ音すみて秋ややうごく八月のすゑ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0077",
   "pid": "933545",
   "pages": [
    87
   ],
   "no": null,
   "maki": "利公の爲めに",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "曼珠沙華か黑き土に頭あぐ雨やみ空のすめる夕べに墓ならぶ谷中の墓地に利公も小さき墓標を立ててねむれり若き母頭痛むに手を當ててむかふわが子の墓標の白さ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0078",
   "pid": "933545",
   "pages": [
    88
   ],
   "no": null,
   "maki": "利公の爲めに",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "線香の煙墓標をめぐれるを二人ふりむき去りがてにする（大正元年八月——九月）",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0079",
   "pid": "933545",
   "pages": [
    90
   ],
   "no": null,
   "maki": "夏",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "初夏の眞晝の野邊の靑草にそのかげおとし立てる樫の木踏切をよぎれば汽車の遠ひびきレールにきこゆ夏のさみしさ菊に似し白き小花をおほくつけ夏草しげる汽車みちの堤",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0080",
   "pid": "933545",
   "pages": [
    91
   ],
   "no": null,
   "maki": "夏",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "駒込の停車塲に來ればあはれにも萩のにほへる七月の末汽車とまり汽車の出で行く停車塲のダリヤの花の晝のくたびれ草堤の茅が根もとに野いばらの白く泣き居る夏の停車塲",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0081",
   "pid": "933545",
   "pages": [
    92
   ],
   "no": null,
   "maki": "夏",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "夏草のにほひの中にたゞずみて物思ひ居れば日のかげろへる夏草のしげみがなかにうつむける釣鐘草のよそ〳〵しさよ白き指に紅のにじみてなまめけるにほやかさもて咲く葵かな",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0082",
   "pid": "933545",
   "pages": [
    93
   ],
   "no": null,
   "maki": "夏",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ぐらんとの手植ぎよくらん東京の上野の夏をさびしらに咲く何の木に咲ける花にや水無月の夕ぐれ君の門ににほへるうちしめり街のどよめききこえ來る山の手町はかなし夏の夜",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0083",
   "pid": "933545",
   "pages": [
    94
   ],
   "no": null,
   "maki": "夏",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "茶屋女うちは持つ手の汗ばみの晝のけだるさきり〴〵すなく恐ろしき黑雲を背に黃に光る向日葵の花見ればなつかしくろみもつ葉ずゑに紅き花つくる莢竹桃の夏のあはれよ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0084",
   "pid": "933545",
   "pages": [
    95
   ],
   "no": null,
   "maki": "夏",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "からみあふ花びらほどくたまゆらにほのかに搖るゝ月見草かな",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0085",
   "pid": "933545",
   "pages": [
    96
   ],
   "no": null,
   "maki": "指の傷",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "指の傷",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0086",
   "pid": "933545",
   "pages": [
    97
   ],
   "no": null,
   "maki": "指の傷",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "わがこゝろかきみだされて胸つまる君が小指の白き繃帶より添へばヨードホルムのうす甘きにほひ皮膚に惱ましく沁む可愛さのわれなやましむ君がせる指の繃帶白くかなしく",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0087",
   "pid": "933545",
   "pages": [
    98
   ],
   "no": null,
   "maki": "指の傷",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "風觸れず指尖熱き繃帶を君苦にしつゝ寢ねがてにするなやましき夜の寢ざめに肉體を切に感ずる指の傷かな指尖に身うちの熱のあつまりてうみ持つ傷の痛むあけ方",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0088",
   "pid": "933545",
   "pages": [
    99
   ],
   "no": null,
   "maki": "指の傷",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "繃帶の白きもすこしよごれつゝ憎さもおぼゆ可愛さのはて君泣けばかの繃帶のよごれめのいよ〳〵我を吸ひやまぬかな强き日にさすバラソルの日蔭の柄を握れる指の白き繃帶",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0089",
   "pid": "933545",
   "pages": [
    100
   ],
   "no": null,
   "maki": "指の傷",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "指尖の傷の痛みにひゞけつゝ市街の電車のきしるわびしさ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0090",
   "pid": "933545",
   "pages": [
    101
   ],
   "no": null,
   "maki": "夕方に",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "夕方に",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0091",
   "pid": "933545",
   "pages": [
    102
   ],
   "no": null,
   "maki": "夕方に",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "夕方に子供の遊ぶころとなり町にも下る靑きうす靄すかされて泣く目をやりし夕空に遠くやさしき月照り居たり夏來れば築地の朝の好もしさ海の風吹く凌霄花",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0092",
   "pid": "933545",
   "pages": [
    103
   ],
   "no": null,
   "maki": "夕方に",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "バラソルに通り雨落ち來甲走りたる聲を立てつゝむし暑く寢ぐるしき夜も靑白うやゝ冷えそめて鳩なく聲す大風の吹き過ぎ行きし遠き音きゝつゝ居れば夜のおそろしさ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0093",
   "pid": "933545",
   "pages": [
    104
   ],
   "no": null,
   "maki": "夕方に",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "はした女が廚の隅に泣いてゐる白き前かけしみ〴〵かなし泣き止みて頭のいたきたよりなさ幼心地のふとよみがへるおそろしき夏の闇夜に飛びかひし螢の燐の記憶かなしも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0094",
   "pid": "933545",
   "pages": [
    105
   ],
   "no": null,
   "maki": "夕方に",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "風邪の後始めて入れる湯上りのつかれに抱かれ物音をきく寢て見れば寢起のわるさ梅雨時のじめ〳〵とするもの惱ましさ梅雨時の執念き濕りしづみ居る厨の隅の生姜のにほひ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0095",
   "pid": "933545",
   "pages": [
    107
   ],
   "no": null,
   "maki": "蕊",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "鳩起きて軒のとやより挨拶す花壇の芥子は朝風に搖る薔薇色に雲のにほへば朝の唄鳩のうたひて花壇おとなふ眞中の小さき黃色のさかづきに甘き香もれる水仙の花",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0096",
   "pid": "933545",
   "pages": [
    108
   ],
   "no": null,
   "maki": "蕊",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "花びらの眞紅の光澤に强き日を照り返し居る雛芥子の花愛らしき金のさかづきさし上げて日のひかりくむ花菱草よしほらしき野薔薇の花を雨は打つたゝかれて散るほの白き花",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0097",
   "pid": "933545",
   "pages": [
    109
   ],
   "no": null,
   "maki": "蕊",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ゆづり葉の新芽かはゆしやはらかき綠もたぐる桃いろの莖象の肌のけうとさおもふ椿の木枝さき重き花のかたまり黑もじのうす黃の花にやはらかき雨ふりそゝぎ春の暮れ行く",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0098",
   "pid": "933545",
   "pages": [
    110
   ],
   "no": null,
   "maki": "蕊",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "愛に醉ふ雌蕊雄蕊を取りかこむうばらの花をつつむ晝の日花びらをひろげ疲れしおとろへに牡丹重たく萼をはなるゝ芍藥の黃いろの花粉日にたゞれ香をかぐ人に媚藥吐く",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0099",
   "pid": "933545",
   "pages": [
    111
   ],
   "no": null,
   "maki": "蕊",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "桐の花露のおりくる黎明にうす紫のしとやかさかな桃の實の肌のやうなるうぶ毛して少年の頰のうひ〳〵しさよ金魚草にトンボとまりて金の眼を日にまはす時ドンのとゞろく",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0100",
   "pid": "933545",
   "pages": [
    112
   ],
   "no": null,
   "maki": "蕊",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "眞晝野に晝顏咲けりまじ〴〵と待つものもなき晝顏の花あつき日を幾日も吸ひてつゆ甘く葡萄の熟す深き夏かな",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0101",
   "pid": "933545",
   "pages": [
    114
   ],
   "no": null,
   "maki": "紐",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "結べども桃いろにならぬ愁かなくれなゐの紐白妙の紐紅薔薇見し眼を移す白百合のそのうす靑さ君が頰に見る如月や電車に遠き山の手のからたち垣に三十三才鳴く",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0102",
   "pid": "933545",
   "pages": [
    115
   ],
   "no": null,
   "maki": "紐",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "宿の山蜜柑ならびて黃なる實の朝日受け取る枝葉の中に菜の花の黃色小雨にとけあひてほのににじめる晝のあかるみ二階より君とならびて肩ふれて見下す庭のヒヤシンスかな",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0103",
   "pid": "933545",
   "pages": [
    116
   ],
   "no": null,
   "maki": "紐",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "舞ひ終へて扇を前に會釋する舞妓が肩の息なつかしむ灰いろに埃かゝれるかなめ垣うるほふ雨に矢來を通る汽船に居て湊の町のわか葉見る陸にも海にも晝の日光る",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0104",
   "pid": "933545",
   "pages": [
    117
   ],
   "no": null,
   "maki": "紐",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "海荒るゝ前の沈默雲おもく島山よもぎにほひながるゝ水引の根をあらひ行く野の水の淀みにうつる秋の夕映",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0105",
   "pid": "933545",
   "pages": [
    118
   ],
   "no": null,
   "maki": "あかり",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "あかり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0106",
   "pid": "933545",
   "pages": [
    119
   ],
   "no": null,
   "maki": "あかり",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "母は子に思ひ絕えよとさとしけりその夜の月は二人てらしぬ戀ゆゑに人をあやめしたをや女の墓ある寺の紅梅の花をんな坂袖もつれあふ舞姫がかすみに濡るゝ朝詣かな",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0107",
   "pid": "933545",
   "pages": [
    120
   ],
   "no": null,
   "maki": "あかり",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "顏と顏よせて行燈の繪を見るや櫻ににほふうすあかり哉物かげに怖ぢし目高のにげさまにさゝ濁りする春の水哉風絕えてくもる眞晝をものうげに虻なく畑のそら豆の花",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0108",
   "pid": "933545",
   "pages": [
    121
   ],
   "no": null,
   "maki": "あかり",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "空もやう氣にしてもどる嫂に門の桃散る雨ふくむ風蓴菜生ふる池をめぐりて奧庭の祠見に行く晝の雨かな水ぐるま近きひゞきに少しゆれ少しゆれゐる小手鞠の花",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0109",
   "pid": "933545",
   "pages": [
    122
   ],
   "no": null,
   "maki": "あかり",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "うす曇遠がみなりをきく野邊の小草がなかの晝顏の花川風に堤の野菊花ゆれてさむき朝なり鳰鳥のなく（明治四十一年十月利根川に遊ぶ四首）網に入る鮭のうろこにうそ寒う夕日ひかりぬ船の秋風",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0110",
   "pid": "933545",
   "pages": [
    123
   ],
   "no": null,
   "maki": "あかり",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "月さむき夜頃となりぬ蘆の穂のしろき堤のこほろぎの聲一村の夢おだやかに月ふけて小草の露に虫の音ぞすむ家ごとに引窓つけてあかりとる竹の山崎籔のうへの月",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0111",
   "pid": "933545",
   "pages": [
    124
   ],
   "no": null,
   "maki": "あかり",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "うしろつきもしやと思ひおもふ間に傘遠ざかるたそがれの雪",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0112",
   "pid": "933545",
   "pages": [
    125
   ],
   "no": null,
   "maki": "八つロ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "八つ口",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0113",
   "pid": "933545",
   "pages": [
    126
   ],
   "no": null,
   "maki": "八つロ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "うす雪は小雨にとけてうぐひすのさゝなきをきく籔かげの道春の雪をんなの人の八つ口の傘をこぼれて匂ふみちわるいもうとの小さき歩みいそがせて千代紙かひに行く月夜かな",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0114",
   "pid": "933545",
   "pages": [
    127
   ],
   "no": null,
   "maki": "八つロ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "おくれては母のあと追ふをさな兒のおさげの髪に春の風吹く二人には春雨小傘ちひさくてたもとぬれけり菜の花のみち田舍町の料理屋の庭に桃が咲きならべてほせる番傘ひかる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0115",
   "pid": "933545",
   "pages": [
    128
   ],
   "no": null,
   "maki": "八つロ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "藪かげのくろき朽葉のうづたかき流に落つる紅椿かな燕とぶ雨後の往來日陰日なたくつきりせるをよろこびとほる朝月は小萩の露にしづみけりあかつきやみのこほろぎの聲",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0116",
   "pid": "933545",
   "pages": [
    129
   ],
   "no": null,
   "maki": "八つロ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "大原や野菊花咲くみちのべに京へ行く子か、母と憩へる野菊一むら水をおほへるいさら川さゝやき細ゝ野は暮れにけり落葉やく靑き煙のよどみたる林をゆけば雨のおちくる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0117",
   "pid": "933545",
   "pages": [
    130
   ],
   "no": null,
   "maki": "八つロ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "時雨降り早仕舞せる宵町のくゞり障子のともし灯の色",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0118",
   "pid": "933545",
   "pages": [
    131
   ],
   "no": null,
   "maki": "八つロ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "集のすゑにこゝに集めたのは、明治三十四年自分が十六歲の頃から、大正二年二十八歲迄の歌である。しかし前の歌は少く近年の歌が多い。並べ方は新しいのを先にした。今の自分に近いものから順にした迄である。この集を公けにするに當つて、自分が未だ十三歲位の少年の頃から、ねんごろな教を賜つた佐々木信綱先生と、常に直接間",
   "sachu": "",
   "poems": []
  },
  {
   "id": "kinoshita-toshiharu-933545-0119",
   "pid": "933545",
   "pages": [
    132
   ],
   "no": null,
   "maki": "八つロ",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "接に自分を激勵してくれた白樺同人諸兄に、心より感謝の意を捧げる。又、有島生馬三浦直介二兄の一方ならぬ好意によつて、此集が好もしい體裁に出來たのを、自分は難有く思つて居る。自分の初子の利公は、一昨年の八月六日の朝生れ、五日間生きて居て、十日の夕方に死んだ。彼は月足らずであつたから、胎內で外界の生活に堪へるだけの準備が出來て居なかつた。こんなに今生の緣の薄いものではあつたが、自分は產婦に知らせられない間は一人で、知らせてからは二人で顏をしめて泣いた。子供を失ふ悲をひし〳〵と知つた。集中「利公の爲に」と云ふ一章は當時の作である。この集を彼に贈つたのも、利公を記念する爲の親心に他ならぬ。大正三年三月三日利玄",
   "sachu": "",
   "poems": []
  }
 ],
